pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m pip install \
                      -r requirements.txt
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    python3 -m pytest -v
                '''
            }
        }

        stage('Validate Ansible') {
            steps {
                sh '''
                    ansible-playbook \
                      -i ansible/inventory.ini \
                      ansible/site.yml \
                      --syntax-check
                '''
            }
        }

        stage('Package') {
            steps {

                sh '''
                    tar -czf \
                      incident-agent-${BUILD_NUMBER}.tar.gz \
                      agent \
                      ansible
                '''

                archiveArtifacts(
                    artifacts:
                      'incident-agent-*.tar.gz',
                    fingerprint: true
                )
            }
        }
    }
}
